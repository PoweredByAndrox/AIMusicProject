# Application Settings
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_PORT=8000

# Database Settings (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=music_recommendations
DB_USERNAME=postgres
DB_PASSWORD=secret

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue Settings
QUEUE_CONNECTION=redis

# File Storage
FILESYSTEM_DISK=local
STORAGE_PATH=/var/www/html/storage/app

# ML Worker Settings
FAISS_INDEX_PATH=/app/faiss_index
MODELS_PATH=/app/models

# Local LLM Settings
# LLM_PROVIDER=ollama keeps the default Ollama backend.
# Set LLM_PROVIDER=vllm and start the llm-vllm compose profile only for text LLM/controller inference.
# vLLM does not run Demucs/MDX/BS-RoFormer/MelBand/SCNet audio separator models.
LLM_PROVIDER=ollama
LLM_TIMEOUT=120
LLM_MODEL=
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_PORT=11434
VLLM_URL=http://vllm:8000/v1
VLLM_PORT=8001
VLLM_MODEL=
VLLM_QUANTIZATION=awq_marlin
VLLM_DTYPE=auto
VLLM_KV_CACHE_DTYPE=auto
VLLM_SAFETENSORS_LOAD_STRATEGY=prefetch
VLLM_GPU_MEMORY_UTILIZATION=0.82
VLLM_MAX_MODEL_LEN=8192
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_NUM_BATCHED_TOKENS=4096

# Audio separator serving settings.
# This is for Demucs/MDX/MelBand/SCNet runtime optimization, not a text LLM.
SEPARATOR_SERVER_PORT=8791

# Node/Vite Settings
NODE_ENV=development
VITE_PORT=5173
VITE_API_URL=http://localhost:8000
