# Application Settings
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000
APP_PORT=8000

# Database Settings (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=music_recommendations
DB_USERNAME=postgres
DB_PASSWORD=secret

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue Settings
QUEUE_CONNECTION=redis

# File Storage
FILESYSTEM_DISK=local
STORAGE_PATH=/var/www/html/storage/app

# ML Worker Settings
FAISS_INDEX_PATH=/app/faiss_index
MODELS_PATH=/app/models

# Node/Vite Settings
NODE_ENV=development
VITE_PORT=5173
VITE_API_URL=http://localhost:8000
