API_PORT=8000
FRONTEND_PORT=5173
DATA_ROOT=/app/data
CONFIG_ROOT=/app/configs
DRY_RUN=true

WORKER_DEMUCS_URL=http://demucs-worker:8000
WORKER_BSROFORMER_URL=http://bsroformer-worker:8000
WORKER_AUDIO_SEPARATOR_URL=http://audio-separator-worker:8000
WORKER_QUERYSEP_URL=http://querysep-worker:8000
WORKER_RESTORATION_URL=http://restoration-worker:8000
WORKER_LYRICS_URL=http://lyrics-worker:8000

# lyrics-worker runtime
LYRICS_DEVICE=auto
LYRICS_COMPUTE_TYPE=auto
LYRICS_BATCH_SIZE=8
LYRICS_WHISPERX_MODEL=large-v3
LYRICS_ALIGN_MODEL=large-v3

# bsroformer-worker Test-Time Augmentation (R6).
# off       - 1 forward pass (legacy timing)
# standard  - 2 passes (orig + polarity flip), recommended for accuracy_max
# aggressive- 4 passes (orig + polarity + L/R swap + both)
BSR_TTA=standard
